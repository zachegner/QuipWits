# AI provider for prompt generation: 'anthropic' (default) or 'xai'
# This is set automatically when you select a provider in the host settings screen.
# AI_PROVIDER=anthropic

# Anthropic Claude API key (used when AI_PROVIDER=anthropic)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# xAI Grok API key (used when AI_PROVIDER=xai)
# Get your key from: https://console.x.ai/
XAI_API_KEY=your_xai_key_here

# Server port (optional, defaults to 3000)
PORT=3000
